NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

PORT=4000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
# Reserved for trusted backend administration only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=crypto-exist-media
R2_PUBLIC_BASE_URL=
CORS_ORIGIN=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MINUTE=120
# Production defaults to disabled. Set true only when API docs must be exposed.
SWAGGER_ENABLED=true
# Use false unless running behind a trusted reverse proxy. Cloudflare commonly uses 1 hop.
TRUST_PROXY=false
